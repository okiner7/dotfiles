# wallust: цвета для Zsh
# Не редактировать вручную — файл перезаписывается wallust.
# Подключается в ~/.zshrc и перезагружается в precmd-хуке.

export WALLUST_BACKGROUND="{{background}}"
export WALLUST_FOREGROUND="{{foreground}}"
export WALLUST_CURSOR="{{cursor}}"

export WALLUST_COLOR0="{{color0}}"
export WALLUST_COLOR1="{{color1}}"
export WALLUST_COLOR2="{{color2}}"
export WALLUST_COLOR3="{{color3}}"
export WALLUST_COLOR4="{{color4}}"
export WALLUST_COLOR5="{{color5}}"
export WALLUST_COLOR6="{{color6}}"
export WALLUST_COLOR7="{{color7}}"
export WALLUST_COLOR8="{{color8}}"
export WALLUST_COLOR9="{{color9}}"
export WALLUST_COLOR10="{{color10}}"
export WALLUST_COLOR11="{{color11}}"
export WALLUST_COLOR12="{{color12}}"
export WALLUST_COLOR13="{{color13}}"
export WALLUST_COLOR14="{{color14}}"
export WALLUST_COLOR15="{{color15}}"

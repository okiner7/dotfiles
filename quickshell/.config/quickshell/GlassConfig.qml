pragma Singleton

import Quickshell

// Глобальные настройки стекла для всей системы: лаунчер, бар, OSD,
// уведомления, power menu. Правь только этот файл — остальное подхватится само.
//
// Как это работает:
//   - размытие фона рисует композитор (Hyprland) по протоколу
//     ext-background-effect-v1: QML отдаёт ему регион (Region), а тот
//     размывает только его — поэтому размытие не выходит за края плиты;
//   - сила и радиус размытия задаются в Hyprland (decoration:blur:*),
//     здесь только форма и прозрачность самого стекла;
//   - цвета берутся из палитры wallust (см. Theme.qml).

Singleton {
    // --- Геометрия ---

    // Радиус скругления углов стекла.
    property int radius: 28

    // Толщина волосяной рамки по контуру.
    property int borderWidth: 1

    // --- Размытие фона под плитой ---

    // Включать ли размытие вообще.
    property bool blurEnabled: true

    // Радиус скругления региона размытия. Обычно совпадает с radius,
    // иначе размытый прямоугольник вылезет из-под скруглённой плиты.
    property int blurRadius: 28

    // --- Заливка стекла ---

    // Общий множитель прозрачности заливки.
    property real glassAlpha: 1.0

    // Прозрачность верхней кромки (светлее всего).
    property real topAlpha: 0.16

    // Прозрачность тела плиты.
    property real bodyAlpha: 0.07

    // Прозрачность низа плиты (уходит в цвет фона).
    property real baseAlpha: 0.50

    // --- Блик, обводка, акцент ---

    // Сила верхнего блика.
    property real specular: 1.0

    // Прозрачность волосяной рамки.
    property real borderAlpha: 0.16

    // Сила акцентного подмеса у нижней кромки (цвет едет с обоями).
    property real accentAlpha: 0.10

    // --- Тень ---

    // Насыщенность тени под стеклом.
    property real shadowOpacity: 0.45

    // Радиус размытия тени.
    property real shadowBlur: 30

    // Сдвиг тени вниз.
    property real shadowOffset: 10

    // --- Бар (верхняя стеклянная полоса) ---

    // Высота самой полосы.
    property int barHeight: 40

    // Отступ от верхнего края экрана.
    property int barMargin: 8

    // Скругление: половина высоты — получается пилюля.
    property int barRadius: 20

    // Прозрачность заливки бара (плоская, без градиента карточки).
    property real barAlpha: 0.38
}
